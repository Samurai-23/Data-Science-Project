    "}\n",
    "\n",
    "image_records = []\n",
    "\n",
    "for root, dirs, files in os.walk(base_folder):\n",
    "    for file in sorted(files):\n",
    "        if not file.lower().endswith(\".zip\"):\n",
    "            continue\n",
    "\n",
    "        zip_path = os.path.join(root, file)\n",
    "        contributor = os.path.basename(root)\n",
    "        archive_relative_path = os.path.relpath(\n",
    "            zip_path, base_folder\n",
    "        )\n",
    "\n",
    "        with zipfile.ZipFile(zip_path, \"r\") as archive:\n",
    "            for member in archive.namelist():\n",
    "\n",
    "                if PurePosixPath(member).suffix.lower() not in image_extensions:\n",
    "                    continue\n",
    "\n",
    "                image_path = PurePosixPath(member)\n",
    "                original_label = image_path.parent.name\n",
    "\n",
    "                image_records.append({\n",
    "                    \"Contributor\": contributor,\n",
    "                    \"ZIP_File\": file,\n",
    "                    \"Archive_Path\": archive_relative_path,\n",
    "                    \"Internal_Image_Path\": member,\n",
    "                    \"Image_Filename\": image_path.name,\n",
    "                    \"Original_Label\": original_label,\n",
    "                    \"Final_Class\": map_final_class(original_label)\n",
    "                })\n",
