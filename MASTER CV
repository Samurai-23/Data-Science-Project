    "source_links = {\n",
    "    \"BRISC2025\": (\n",
    "        \"https://www.kaggle.com/datasets/briscdataset/brisc2025?resource=download\"\n",
    "    ),\n",
    "    \"AJITHDARI_STROKE\": (\n",
    "        \"https://www.kaggle.com/datasets/ajithdari/multi-class-brain-mri-dataset\"\n",
    "    ),\n",
    "    \"BILALAKGZ_TUMOUR\": (\n",
    "        \"https://www.kaggle.com/datasets/bilalakgz/brain-tumor-mri-dataset\"\n",
    "    ),\n",
    "    \"TURKERTUNCER_STROKE\": (\n",
    "        \"https://www.kaggle.com/datasets/turkertuncer/multimodal-stroke-image-dataset\"\n",
    "    ),\n",
    "    \"DEEPPYTHONIST_TUMOUR\": (\n",
    "        \"https://www.kaggle.com/datasets/deeppythonist/brain-tumor-mri-dataset\"\n",
    "    ),\n",
    "    \"MASOUDNICKPARVAR_TUMOUR\": (\n",
    "        \"https://www.kaggle.com/datasets/masoudnickparvar/brain-tumor-mri-dataset\"\n",
    "    ),\n",
    "    \"BHSD\": (\n",
    "        \"https://huggingface.co/datasets/Wendy-Fly/BHSD\"\n",
    "    ),\n",
    "    \"MITANGSHU11_STROKE\": (\n",
    "        \"https://www.kaggle.com/datasets/mitangshu11/brain-stroke-mri-images\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "def assign_source(row):\n",
    "    contributor = row[\"Contributor\"]\n",
    "    zip_file = row[\"ZIP_File\"]\n",
    "    label = normalize(row[\"Original_Label\"])\n",
    "\n",
    "    # EXTRA IMAGES\n",
    "    if contributor == \"EXTRA IMAGES\":\n",
    "        if label in [\"glioma\", \"meningioma\", \"normal\", \"pituitary\"]:\n",
    "            return source_links[\"BRISC2025\"], \"EXTRA/TUMOR LINK.txt\", \"Mapped\"\n",
    "        if label in [\"no stroke\", \"stroke\"]:\n",
    "            return source_links[\"AJITHDARI_STROKE\"], \"EXTRA/STROKE LINKS.txt\", \"Mapped\"\n",
    "\n",
    "    # MOHAMEDUZAIF\n",
    "    if contributor == \"MOHAMEDUZAIF\":\n",
    "        return source_links[\"BILALAKGZ_TUMOUR\"], \"LINK.txt\", \"Mapped\"\n",
    "\n",
    "    # NORMA\n",
    "    if contributor == \"NORMA\":\n",
    "        if zip_file == \"normal norma.zip\":\n",
    "            if label == \"no stroke\":\n",
    "                return source_links[\"AJITHDARI_STROKE\"], \"STROKE LINK.txt\", \"Mapped\"\n",
    "            if label == \"no tumor\":\n",
    "                return source_links[\"BRISC2025\"], \"TUMOR LINK.txt\", \"Mapped\"\n",
    "\n",
    "        if zip_file == \"stroke norma.zip\":\n",
    "            return source_links[\"AJITHDARI_STROKE\"], \"STROKE LINK.txt\", \"Mapped\"\n",
    "\n",
    "        if zip_file == \"tumor (2) norma.zip\":\n",
    "            return source_links[\"BRISC2025\"], \"TUMOR LINK.txt\", \"Mapped\"\n",
    "\n",
    "    # SIYABONGA\n",
    "    if contributor == \"SIYABONGA\":\n",
    "        if label == \"stroke\":\n",
    "            return source_links[\"TURKERTUNCER_STROKE\"], \"LINKS STROKE.txt\", \"Mapped\"\n",
    "        if label == \"tumour\":\n",
    "            return source_links[\"DEEPPYTHONIST_TUMOUR\"], \"LINKS TUMOR.txt\", \"Mapped\"\n",
    "\n",
    "    # SUHAIL\n",
    "    if contributor == \"SUHAIL\":\n",
    "        return source_links[\"MASOUDNICKPARVAR_TUMOUR\"], \"LINK.txt\", \"Mapped\"\n",
    "\n",
    "    # SUMAIRAA\n",
    "    if contributor == \"SUMAIRAA\":\n",
    "        return source_links[\"BHSD\"], \"LINKS.txt\", \"Mapped\"\n",
    "\n",
    "    # ZANIB\n",
    "    if contributor == \"ZANIB\":\n",
    "        if label == \"sroke\":\n",
    "            return source_links[\"MITANGSHU11_STROKE\"], \"STROKE LINKS.txt\", \"Mapped\"\n",
    "        if label == \"tumor\":\n",
    "            return source_links[\"MASOUDNICKPARVAR_TUMOUR\"], \"TUMOR LINKS.txt\", \"Mapped\"\n",
    "        if label == \"normal\":\n",
    "            return None, \"STROKE LINKS.txt; TUMOR LINKS.txt\", \"Needs source review\"\n",
    "\n",
    "    return None, None, \"Needs source review\"\n",
    "\n",
    "\n",
    "label_summary[\n",
    "    [\"Source_URL\", \"Source_Link_File\", \"Source_Status\"]\n",
    "] = label_summary.apply(\n",
    "    lambda row: pd.Series(assign_source(row)),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "display(label_summary)\n",
    "\n",
    "print(\"\\nTotal images:\", label_summary[\"Image_Count\"].sum())\n",
    "\n",
    "print(\"\\nSource mapping status:\")\n",
    "print(\n",
    "    label_summary.groupby(\"Source_Status\")[\"Image_Count\"]\n",
    "    .sum()\n",
    "    .sort_index()\n",
    ")\n",
    "\n",
    "print(\"\\nRows needing source review:\")\n",
    "display(\n",
    "    label_summary[label_summary[\"Source_Status\"] != \"Mapped\"][\n",
    "        [\"Contributor\", \"ZIP_File\", \"Original_Label\",\n",
    "         \"Final_Class\", \"Image_Count\", \"Source_Status\"]\n",
    "    ]\n",
    ")"
