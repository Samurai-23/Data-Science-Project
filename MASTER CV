    "import os\n",
    "import zipfile\n",
    "from collections import Counter\n",
    "\n",
    "base_folder = r\"C:\\Users\\njrad\\Downloads\\ORIGINA UNCLEANED DATASETS\\DATASETS\"\n",
    "\n",
    "image_extensions = {\".jpg\", \".jpeg\", \".png\", \".bmp\", \".tif\", \".tiff\", \".webp\"}\n",
    "\n",
    "for root, dirs, files in os.walk(base_folder):\n",
    "    for file in sorted(files):\n",
    "        if file.lower().endswith(\".zip\"):\n",
    "            zip_path = os.path.join(root, file)\n",
    "\n",
    "            print(f\"\\n{'=' * 65}\")\n",
    "            print(f\"ZIP FILE: {os.path.relpath(zip_path, base_folder)}\")\n",
    "            print(\"=\" * 65)\n",
    "\n",
    "            try:\n",
    "                with zipfile.ZipFile(zip_path, \"r\") as archive:\n",
    "                    members = [\n",
    "                        name for name in archive.namelist()\n",
    "                        if not name.endswith(\"/\")\n",
    "                    ]\n",
    "\n",
    "                    top_level = sorted({\n",
    "                        name.split(\"/\")[0]\n",
    "                        for name in members\n",
    "                    })\n",
    "\n",
    "                    image_files = [\n",
    "                        name for name in members\n",
    "                        if os.path.splitext(name)[1].lower() in image_extensions\n",
    "                    ]\n",
    "\n",
    "                    text_files = [\n",
    "                        name for name in members\n",
    "                        if name.lower().endswith(\".txt\")\n",
    "                    ]\n",
    "\n",
    "                    print(\"Top-level contents:\", top_level)\n",
    "                    print(\"Total files:\", len(members))\n",
    "                    print(\"Total image files:\", len(image_files))\n",
    "                    print(\"Image formats:\", dict(Counter(\n",
    "                        os.path.splitext(name)[1].lower()\n",
    "                        for name in image_files\n",
    "                    )))\n",
    "                    print(\"Text/link files inside ZIP:\")\n",
    "\n",
    "                    if text_files:\n",
    "                        for name in text_files:\n",
    "                            print(\" -\", name)\n",
    "                    else:\n",
    "                        print(\" - No .txt files found\")\n",
    "\n",
    "            except zipfile.BadZipFile:\n",
    "                print(\"ERROR: This ZIP file could not be opened.\")"
   ]
