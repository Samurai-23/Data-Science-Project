    "def assign_source_updated(row):\n",
    "    # Keep the existing mappings for all contributors\n",
    "    result = assign_source(row)\n",
    "\n",
    "    contributor = row[\"Contributor\"]\n",
    "    label = normalize(row[\"Original_Label\"])\n",
    "\n",
    "    # ZANIB's Normal images may come from either dataset\n",
    "    if contributor == \"ZANIB\" and label == \"normal\":\n",
    "        return (\n",
    "            source_links[\"MITANGSHU11_STROKE\"]\n",
    "            + \" | \"\n",
    "            + source_links[\"MASOUDNICKPARVAR_TUMOUR\"],\n",
    "            \"STROKE LINKS.txt; TUMOR LINKS.txt\",\n",
    "            \"Either source possible\"\n",
    "        )\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "# Update the source information in the summary table\n",
    "label_summary[\n",
    "    [\"Source_URL\", \"Source_Link_File\", \"Source_Status\"]\n",
    "] = label_summary.apply(\n",
    "    lambda row: pd.Series(assign_source_updated(row)),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "display(label_summary)\n",
    "\n",
    "print(\"\\nTotal images:\", label_summary[\"Image_Count\"].sum())\n",
