    "# Add this mapping to the map_final_class() function:\n",
    "# Include \"pitua\" in the tumour-label list.\n",
    "\n",
    "def map_final_class(original_label):\n",
    "    label = normalize(original_label)\n",
    "\n",
    "    if any(term in label for term in [\n",
    "        \"normal\", \"no stroke\", \"no tumor\", \"no tumour\",\n",
    "        \"notumor\", \"notumour\"\n",
    "    ]):\n",
    "        return \"Normal\"\n",
    "\n",
    "    if any(term in label for term in [\n",
    "        \"glioma\", \"meningioma\", \"pituitary\", \"pitua\",\n",
    "        \"tumor\", \"tumour\"\n",
    "    ]):\n",
    "        return \"Tumour\"\n",
    "\n",
    "    if any(term in label for term in [\n",
    "        \"stroke\", \"sroke\", \"ischemic\", \"ischaemic\",\n",
    "        \"hemorrhagic\", \"haemorrhagic\"\n",
    "    ]):\n",
    "        return \"Stroke\"\n",
    "\n",
    "    return \"Needs review\"\n",
    "\n",
    "\n",
    "# Recalculate the final classes using the existing summary table.\n",
    "label_summary[\"Final_Class\"] = label_summary[\"Original_Label\"].apply(\n",
    "    map_final_class\n",
    ")\n",
    "\n",
    "display(label_summary)\n",
