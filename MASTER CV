    "\n",
    "                original_label = PurePosixPath(name).parent.name\n",
    "                final_class = map_final_class(original_label)\n",
    "\n",
    "                summary[\n",
    "                    (contributor, file, original_label, final_class)\n",
    "                ] += 1\n",
    "\n",
    "rows = [\n",
    "    {\n",
    "        \"Contributor\": contributor,\n",
    "        \"ZIP_File\": zip_file,\n",
    "        \"Original_Label\": label,\n",
    "        \"Final_Class\": final_class,\n",
    "        \"Image_Count\": count\n",
