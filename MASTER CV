    "    elif \"briscdataset/brisc2025\" in url:\n",
    "        return \"BRISC2025\"\n",
    "    elif \"ajithdari\" in url:\n",
    "        return \"Ajithdari Stroke\"\n",
    "    elif \"bilalakgz\" in url:\n",
    "        return \"Bilalakgz Tumour\"\n",
    "    elif \"turkertuncer\" in url:\n",
    "        return \"Turkertuncer Stroke\"\n",
    "    elif \"deeppythonist\" in url:\n",
    "        return \"Deeppythonist Tumour\"\n",
    "    elif \"masoudnickparvar\" in url:\n",
    "        return \"Masoudnickparvar Tumour\"\n",
    "    elif \"wendy-fly/bhsd\" in url:\n",
    "        return \"BHSD\"\n",
    "    elif \"mitangshu11\" in url:\n",
    "        return \"Mitangshu11 Stroke\"\n",
    "    else:\n",
    "        return \"Other / Unmapped\"\n",
    "\n",
    "\n",
    "plot_data = master_metadata.copy()\n",
