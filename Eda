# Main
# --------------------------------------------------------------------------- #
def main():
    ap = argparse.ArgumentParser(description="MRI dataset analysis")
    ap.add_argument("root", type=Path, help="dataset root folder")
    ap.add_argument("--out", type=Path, default=Path("data_analysis_output"),
                    help="output folder (default: data_analysis_output)")
    ap.add_argument("--samples", type=int, default=6, help="images per class in sample grid")
    ap.add_argument("--seed", type=int, default=42, help="random seed for sampling")
    ap.add_argument("--show", action="store_true", help="open the sample grid window")
    args = ap.parse_args()

    if not args.root.is_dir():
        raise SystemExit(f"Folder not found: {args.root}")
    args.out.mkdir(parents=True, exist_ok=True)

    print(f"Scanning {args.root} ...")
    files = discover_images(args.root)
    if files.empty:
        raise SystemExit("No images found.")
    print(f"Found {len(files)} images:")
    print(files["class"].value_counts().to_string())

    unlabelled = (files["class"] == "Unlabelled").sum()
    if unlabelled:
        print(f"WARNING: {unlabelled} images are not inside a Normal/Tumour/Stroke folder.")

    print("\nReading images ...")
    meta = analyse_dataset(files)

    dimension_and_size_report(meta, args.out)
    sample_grids(meta, args.out, args.samples, args.seed, args.show)
    data_quality_table(meta, args.out)

    print(f"\nDone. All outputs are in: {args.out.resolve()}")


if __name__ == "__main__":
    main()


